{
  "name": "7k-score-tracker",
  "version": "1.2.16",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "7K Score Tracker: your recent 7K plays in oss!idle, their XP per skill, and the maps that give you the most XP per minute.",
  "keywords": [
    "7k",
    "xp",
    "plays",
    "tracker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaiLTC/7k-score-tracker.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "changelog": "node scripts/changelog.mjs",
    "prebuild": "node scripts/changelog.mjs",
    "build": "oss-idle-addon build",
    "dev": "oss-idle-addon build --watch",
    "setup": "oss-idle-addon setup",
    "release": "oss-idle-addon release",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --test test/",
    "check": "npm run changelog && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@oss-idle/addon-sdk": "0.9.0"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0"
  }
}
